{
  "name": "perchbot",
  "version": "0.5.0",
  "description": "A tiny animated desktop companion that reacts to what your coding agent is doing, driven by Claude Code hooks.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kadirdemirkaya/perchbot.git"
  },
  "main": "app/main.js",
  "bin": {
    "perchbot": "bin/perchbot.js"
  },
  "files": [
    "app/",
    "bin/",
    "characters/",
    "hooks/",
    "lib/",
    "scripts/simulate.js",
    "setup.js",
    "uninstall.js",
    "THIRD_PARTY_NOTICES.md"
  ],
  "keywords": [
    "desktop-companion",
    "overlay",
    "electron",
    "hooks",
    "claude-code"
  ],
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "simulate": "node scripts/simulate.js",
    "setup": "node setup.js",
    "uninstall-hooks": "node uninstall.js",
    "test": "node --test",
    "make-icons": "node scripts/make-icons.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "electron": "45.3.1"
  }
}
